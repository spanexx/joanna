# ============================================================
#  Only the built site in /docs is committed — that is what GitHub
#  Pages serves. Everything else (source, deps, tooling) is ignored.
# ============================================================

# --- ignore everything, then whitelist only /docs ---
*
!.gitignore
!README.md
!docs/
# git does not descend into an excluded directory, so re-include it first
!docs/**

# docs/ contents: only the deployable output
!docs/index.html
!docs/404.html
!docs/.nojekyll
!docs/favicon.svg
!docs/joanna-photo.jpg
!docs/*.js
!docs/*.css
!docs/clients/**
# never ship source maps or TS sources to Pages
docs/**/*.map
docs/**/*.ts

# --- deps, build caches, tooling output ---
node_modules/
web/node_modules/
web/.angular/
web/dist/
web/out-tsc/
web/coverage/
web/*.tsbuildinfo
tools/shots/
tools/slices/
tools/parity.json
tools/*.log

# --- editors / OS / secrets ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.env
.env.local
*.log